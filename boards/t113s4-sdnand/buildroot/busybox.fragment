# storage.py requires blkid to identify ext4 before mounting UDISK.
CONFIG_BLKID=y
CONFIG_FEATURE_BLKID_TYPE=y
# Native system init uses background PID creation and exact process ownership.
CONFIG_START_STOP_DAEMON=y
CONFIG_FEATURE_START_STOP_DAEMON_FANCY=y
CONFIG_READLINK=y
CONFIG_TR=y
CONFIG_MODPROBE=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_UDHCPC=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
# Bounded client-only network clock recovery on boards without retained RTC.
CONFIG_TIMEOUT=y
CONFIG_NTPD=y
# CONFIG_FEATURE_NTPD_SERVER is not set
# CONFIG_FEATURE_NTPD_CONF is not set
