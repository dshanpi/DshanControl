#!/bin/sh
# One system-owned daemon for display IPC and independent update tasks.
set -eu
BIN=/usr/bin/dshancontrol-runtime
CONFIG=/etc/dshancontrol/platform-service.json
PID=/var/run/dshancontrol-runtime.pid
SOCKET=/var/run/dshancontrol/platform.sock
LOG=/var/log/dshancontrol-runtime.log
export DSHANCONTROL_PLATFORM_SOCKET=$SOCKET

read_pid() {
    test -f "$PID" && test ! -L "$PID" || return 1
    read -r process_id < "$PID"
    case "$process_id" in ''|*[!0-9]*|0|1) return 1 ;; esac
}

owned() {
    kill -0 "$process_id" 2>/dev/null || return 1
    test "$(readlink "/proc/$process_id/exe")" = "$BIN" || return 1
    # An unrelated invocation of the same binary must never be stopped.
    test "$(tr '\000' '\n' < "/proc/$process_id/cmdline")" = "$(printf '%s\nserve\n%s' "$BIN" "$CONFIG")"
}

ready() {
    owned && test -S "$SOCKET" && "$BIN" rpc update.identity '{}' >/dev/null
}

case "${1:-}" in
start)
    if test -e "$PID" || test -L "$PID"; then
        read_pid || { echo 'Invalid native service PID file' >&2; exit 1; }
        if kill -0 "$process_id" 2>/dev/null; then
            ready
            exit $?
        fi
        rm "$PID"
    fi
    # The original vendor S60 created these aliases before mounting UDISK.
    # Our non-formatting storage policy replaces S60, so retain only that
    # vendor initialization operation here. storage.py then verifies its UDISK
    # alias against the actual boot map and block device before any data writes.
    if test ! -e /dev/by-name/UDISK; then
        . /etc/partition_op.sh
        do_device_node_switch
    fi
    python3 /usr/lib/dshancontrol-update/storage.py
    python3 /usr/lib/dshancontrol-update/initialize.py
    test -x "$BIN" && test -f "$CONFIG"
    mkdir -p /var/run/dshancontrol
    test ! -L "$LOG"
    mkdir -p "$(dirname "$LOG")"
    (umask 077; touch "$LOG")
    chmod 600 "$LOG"
    # Keep the original structured startup error after daemonization. The fixed
    # shell only redirects output and immediately execs the system executable.
    start-stop-daemon -S -b -m -p "$PID" -x /bin/sh -- -c \
        'umask 077; exec "$1" serve "$2" >>"$3" 2>&1' \
        dshancontrol-runtime "$BIN" "$CONFIG" "$LOG"
    # Launch once. Only process ownership and read-only readiness are polled;
    # recovery finishes before the socket accepts requests.
    attempts=0
    while test "$attempts" -lt 30; do
        if read_pid; then
            if ready; then exit 0; fi
            if ! kill -0 "$process_id" 2>/dev/null; then
                echo "Native service exited; see $LOG; no relaunch attempted" >&2
                exit 1
            fi
        fi
        attempts=$((attempts + 1))
        sleep 1
    done
    echo "Native service did not become ready; see $LOG; no relaunch attempted" >&2
    exit 1
    ;;
stop)
    test -e "$PID" || test -L "$PID" || exit 0
    read_pid || { echo 'Invalid native service PID file' >&2; exit 1; }
    if ! kill -0 "$process_id" 2>/dev/null; then rm "$PID"; exit 0; fi
    owned || { echo 'Native service PID belongs to another process' >&2; exit 1; }
    # The daemon refuses shutdown while a task, update or hardware lock is held.
    # No signal/kill fallback and no automatic retry of a refused stop.
    "$BIN" rpc service.shutdown '{}' >/dev/null
    attempts=0
    while test "$attempts" -lt 10; do
        if ! owned; then rm "$PID"; exit 0; fi
        attempts=$((attempts + 1))
        sleep 1
    done
    echo 'Native service shutdown not observed' >&2
    exit 1
    ;;
status)
    read_pid && ready
    ;;
restart)
    "$0" stop
    "$0" start
    ;;
*) echo "usage: $0 {start|stop|status|restart}" >&2; exit 2 ;;
esac
