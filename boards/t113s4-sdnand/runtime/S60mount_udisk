#!/bin/sh
# System-owned persistent storage; no boot-time formatting or data conversion.
set -eu
# A native system must retain its runtime boundary even if the executable fails.
if [ ! -x /usr/bin/dshancontrol-runtime ] && { [ -e /etc/dshancontrol/platform-service.json ] || [ -L /etc/dshancontrol/platform-service.json ]; }; then
    echo 'DshanControl native runtime unavailable; state retained' >&2
    exit 1
fi
case "${1:-}" in
start)
    if [ -x /usr/bin/dshancontrol-runtime ]; then
        exec /usr/bin/dshancontrol-runtime storage-mount
    fi
    exec python3 /usr/lib/dshancontrol-update/storage.py --mount
    ;;
stop) : ;; # Services stop first; the system shutdown sequence unmounts storage.
*) echo "usage: $0 {start|stop}" >&2; exit 2 ;;
esac
