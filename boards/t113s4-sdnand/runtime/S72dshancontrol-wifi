#!/bin/sh
# Board-owned WiFi startup; credentials stay outside application versions.
set -eu
CONFIG_DIR=/mnt/UDISK/dshancontrol/system
CONF=$CONFIG_DIR/wifi.conf
RUN=/var/run/dshancontrol-wifi
PID=$RUN/wpa.pid
WPA=/usr/sbin/wpa_supplicant

owned() {
    test -f "$PID" && test ! -L "$PID" || return 1
    read -r dshan_wifi_pid < "$PID" || return 1
    case "$dshan_wifi_pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
    test "$(readlink "/proc/$dshan_wifi_pid/exe")" = "$WPA" || return 1
    test "$(tr '\000' '\n' < "/proc/$dshan_wifi_pid/cmdline")" = \
        "$(printf '%s\n' "$WPA" -B -P "$PID" -i wlan0 -D nl80211 -c "$CONF" -O "$RUN" -f "$RUN/wpa.log")"
}

case "${1:-}" in
start)
    # S69 has established vendor aliases and the exact ext4 persistent mount.
    python3 /usr/lib/dshancontrol-update/storage.py
    test -d /sys/module/aic8800_bsp || modprobe aic8800_bsp
    test -d /sys/module/aic8800_fdrv || modprobe aic8800_fdrv
    ip link set wlan0 up
    if test ! -e "$CONF" && test ! -L "$CONF"; then
        echo 'DshanControl WiFi: interface ready, no site credentials configured'
        exit 0
    fi
    test ! -L "$CONFIG_DIR" && test ! -L "$CONF" && test -f "$CONF"
    test "$(stat -c '%u:%a' "$CONFIG_DIR")" = 0:700
    case "$(stat -c '%u:%a' "$CONF")" in 0:600|0:400) ;; *)
        echo 'DshanControl WiFi: credentials must be a root-owned private file' >&2
        exit 1 ;;
    esac
    umask 077
    if test -e "$RUN" || test -L "$RUN"; then
        test ! -L "$RUN" && test -d "$RUN"
        test "$(stat -c '%u:%a' "$RUN")" = 0:700
    else
        mkdir "$RUN"
    fi
    if test -e "$PID" || test -L "$PID"; then
        owned || { echo 'DshanControl WiFi: stale or foreign PID; refusing relaunch' >&2; exit 1; }
    else
        if wpa_cli -p /var/run/wpa_supplicant -i wlan0 ping 2>/dev/null | sed -n '/^PONG$/p' | read -r ignored; then
            echo 'DshanControl WiFi: interface is managed by another supplicant' >&2
            exit 1
        fi
        test ! -L "$RUN/wpa.log"
        "$WPA" -B -P "$PID" -i wlan0 -D nl80211 -c "$CONF" -O "$RUN" -f "$RUN/wpa.log"
    fi
    # -B may return before the daemon has published its PID. Readiness polling
    # must not launch another supplicant or race its first PID-file write.
    dshan_wifi_wait=0
    until owned; do
        dshan_wifi_wait=$((dshan_wifi_wait + 1))
        test "$dshan_wifi_wait" -lt 6 || { echo 'DshanControl WiFi: owned supplicant not ready' >&2; exit 1; }
        sleep 1
    done
    dshan_wifi_wait=0
    until test "$(wpa_cli -p "$RUN" -i wlan0 status 2>/dev/null | sed -n 's/^wpa_state=//p')" = COMPLETED; do
        owned || { echo 'DshanControl WiFi: supplicant exited; no relaunch attempted' >&2; exit 1; }
        dshan_wifi_wait=$((dshan_wifi_wait + 1))
        test "$dshan_wifi_wait" -lt 20 || { echo 'DshanControl WiFi: association timed out' >&2; exit 1; }
        sleep 1
    done
    if ! ip -4 -o addr show dev wlan0 | sed -n '/inet /p' | read -r ignored; then
        udhcpc -i wlan0 -q -n -t 3 -T 3 -s /usr/share/udhcpc/default.script > "$RUN/dhcp.log" 2>&1
    fi
    echo 'DshanControl WiFi: associated with IPv4 configured'
    ;;
stop)
    test -e "$PID" || test -L "$PID" || exit 0
    owned || { echo 'DshanControl WiFi: foreign PID; refusing stop' >&2; exit 1; }
    kill -TERM "$dshan_wifi_pid"
    dshan_wifi_wait=0
    while owned; do
        dshan_wifi_wait=$((dshan_wifi_wait + 1))
        test "$dshan_wifi_wait" -lt 6 || { echo 'DshanControl WiFi: stop not observed' >&2; exit 1; }
        sleep 1
    done
    rm -f "$PID"
    ;;
status)
    owned
    wpa_cli -p "$RUN" -i wlan0 status | sed -n '/^wpa_state=/p;/^ip_address=/p'
    ;;
*) echo "usage: $0 {start|stop|status}" >&2; exit 2 ;;
esac
