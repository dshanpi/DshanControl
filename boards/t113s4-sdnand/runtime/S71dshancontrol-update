#!/bin/sh
set -eu
# A native system must retain its runtime boundary even if the executable fails.
if [ ! -x /usr/bin/dshancontrol-runtime ] && { [ -e /etc/dshancontrol/platform-service.json ] || [ -L /etc/dshancontrol/platform-service.json ]; }; then
    echo 'DshanControl native runtime unavailable; state retained' >&2
    exit 1
fi
PID=/var/run/dshancontrol-update.pid
case "${1:-}" in
start)
    if [ -x /usr/bin/dshancontrol-runtime ]; then
        # Native tasks are explicit; do not also start the legacy Python watcher.
        exec /etc/init.d/S69dshancontrol-runtime status
    fi
    # S70 must have initialized the mounted persistent volume first.
    test -L /mnt/UDISK/dshancontrol/apps/current
    if [ -s "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then exit 0; fi
    start-stop-daemon -S -b -m -p "$PID" -x /usr/bin/python3 -- /usr/lib/dshancontrol-update/watch.py
    ;;
stop)
    if [ -x /usr/bin/dshancontrol-runtime ]; then exit 0; fi
    start-stop-daemon -K -p "$PID" -R 10 2>/dev/null || true
    rm -f "$PID"
    ;;
restart) "$0" stop; "$0" start ;;
*) exit 2 ;;
esac
