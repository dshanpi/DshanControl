# Board-owned display settings; baseline is 1024x600 RGB LCD on /dev/fb0.
# Tina uses mdev; do not depend on a udev database for touchscreen discovery.
# Match the controller name because event numbers change with enabled drivers.
export QT_QPA_FB_NO_LIBINPUT=1
for dshan_touch_name in /sys/class/input/event*/device/name; do
    [ -r "$dshan_touch_name" ] || continue
    if [ "$(cat "$dshan_touch_name")" = gt9xxnew_ts ]; then
        dshan_touch_event=${dshan_touch_name%/device/name}
        export QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS=/dev/input/${dshan_touch_event##*/}
        break
    fi
done
unset dshan_touch_name dshan_touch_event
