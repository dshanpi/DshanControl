#!/bin/sh
# Never format storage. Preserve an existing independent eMMC data partition.
set -eu
READY=/run/dshancontrol-storage-ready
case "${1:-}" in
start)
    rm -f "$READY"
    [ ! -L /data ] || { echo 'DshanControl: /data is a symlink' >&2; exit 1; }
    mkdir -p /data
    if [ -b /dev/mmcblk1p3 ]; then
        if awk '$2 == "/data" { found=1 } END { exit !found }' /proc/mounts; then
            awk '$1 == "/dev/mmcblk1p3" && $2 == "/data" && $3 == "ext4" && $4 ~ /(^|,)rw(,|$)/ { ok=1 } END { exit !ok }' /proc/mounts || {
                echo 'DshanControl: unexpected /data mount' >&2; exit 1;
            }
        else
            mount -t ext4 -o noatime,nosuid,nodev /dev/mmcblk1p3 /data
        fi
        MODE=emmc-p3
    else
        [ ! -e /etc/dshancontrol/require-data-partition ] || {
            echo 'DshanControl: required eMMC data partition missing' >&2; exit 1;
        }
        # Fresh two-partition development images retain their documented fallback.
        ! awk '$2 == "/data" { found=1 } END { exit !found }' /proc/mounts || {
            echo 'DshanControl: unexpected /data mount' >&2; exit 1;
        }
        MODE=development-rootfs
    fi
    umask 077
    printf '%s\n' "$MODE" > "$READY"
    ;;
stop) : ;; # User data stays mounted until the normal system shutdown.
*) echo "Usage: $0 {start|stop}" >&2; exit 2 ;;
esac
