#!/bin/sh
set -eu
BASE=/run/dshancontrol
case "${1:-}" in
start)
    [ -f /etc/dshancontrol/platform-service.json ] || exit 0
    /usr/libexec/dshan-imx6ull-services storage
    mkdir -p "$BASE"
    start-stop-daemon -S -q -b -m -p "$BASE/platform.pid" -x /usr/bin/dshancontrol-runtime -- serve /etc/dshancontrol/platform-service.json
    count=0
    until [ -S "$BASE/platform.sock" ]; do
        count=$((count+1))
        [ "$count" -lt 20 ] && kill -0 "$(cat "$BASE/platform.pid")" || exit 1
        sleep 1
    done
    /usr/libexec/dshan-imx6ull-services display-restore
    ;;
stop)
    [ -S "$BASE/platform.sock" ] || exit 0
    DSHANCONTROL_PLATFORM_SOCKET="$BASE/platform.sock" /usr/bin/dshancontrol-runtime rpc service.shutdown '{}'
    ;;
*) echo 'Usage: S98dshan-runtime start|stop' >&2; exit 2;;
esac
