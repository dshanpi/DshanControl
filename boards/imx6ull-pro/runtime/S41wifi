#!/bin/sh
set -eu
CONF=/data/dshancontrol/network/wpa_supplicant.conf
WPA_PID=/run/wpa_supplicant-wlan0.pid
DHCP_PID=/run/udhcpc-wlan0.pid
case "${1:-}" in
start)
    [ -s "$CONF" ] || { echo 'Wi-Fi: no private network profile configured'; exit 0; }
    python3 -c 'import os,stat,sys; s=os.lstat(sys.argv[1]); sys.exit(0 if stat.S_ISREG(s.st_mode) and s.st_uid == 0 and stat.S_IMODE(s.st_mode) == 0o600 else 1)' "$CONF" || { echo 'Wi-Fi profile must be root-owned mode 0600'; exit 1; }
    if [ -f "$WPA_PID" ] && start-stop-daemon -K -t -p "$WPA_PID" -x /usr/sbin/wpa_supplicant >/dev/null 2>&1; then
        echo 'Wi-Fi: supplicant already running'; exit 0
    fi
    ip link set wlan0 up
    /usr/sbin/wpa_supplicant -B -D nl80211 -i wlan0 -c "$CONF" -P "$WPA_PID" -f /var/log/wpa-wlan0.log
    /sbin/udhcpc -b -i wlan0 -p "$DHCP_PID" -t 5 -T 2 -x hostname:DshanControl-6ULL
    ;;
stop)
    if [ -f "$DHCP_PID" ]; then
        start-stop-daemon -K -p "$DHCP_PID" -n udhcpc || exit 1
        rm -f "$DHCP_PID"
    fi
    if [ -f "$WPA_PID" ]; then
        start-stop-daemon -K -p "$WPA_PID" -x /usr/sbin/wpa_supplicant || exit 1
        rm -f "$WPA_PID"
    fi
    ip link set wlan0 down
    ;;
status)
    /usr/sbin/wpa_cli -i wlan0 status
    ip -br address show dev wlan0
    ;;
*) echo "Usage: $0 {start|stop|status}" >&2; exit 1 ;;
esac
