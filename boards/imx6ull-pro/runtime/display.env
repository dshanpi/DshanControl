export QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0
export QT_QPA_FB_NO_LIBINPUT=1
export QT_QPA_PLATFORM_PLUGIN_PATH=/usr/lib/qt/plugins
export QT_LOGGING_RULES='qt.qpa.input=false'
for touch_name in /sys/class/input/event*/device/name; do
    [ -r "$touch_name" ] || continue
    case "$(cat "$touch_name")" in
        goodix-ts|*Goodix*|gt9xxnew_ts)
            touch_event=${touch_name%/device/name}
            export QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS=/dev/input/${touch_event##*/}
            break ;;
    esac
done
unset touch_name touch_event

export DSHANCONTROL_MEDIA_BACKEND=gstreamer-software
export DSHANCONTROL_MEDIA_STATUS_FILE=/run/dshancontrol/media-status.json
