# Root-owned shell configuration. Change only after identifying the board devices.
QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0
QT_QPA_FB_DISABLE_INPUT=0
QT_QPA_FB_HIDECURSOR=1
# Qt evdev discovers devices by default. Set this only for a verified touchscreen:
# QT_QPA_EVDEV_TOUCHSCREEN_PARAMETERS=/dev/input/event1:rotate=0
